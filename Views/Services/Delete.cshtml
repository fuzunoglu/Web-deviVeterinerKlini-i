@model VeterinerKlinigi.Models.Service
@{
    ViewData["Title"] = "Hizmet Sil";
}

<h2>Hizmet Sil</h2>
<div class="alert alert-danger">Bu hizmeti silmek istediğinize emin misiniz?</div>
<dl class="row">
    <dt class="col-sm-3">Ad</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Klinik</dt>
    <dd class="col-sm-9">@Model.Clinic?.Name</dd>
    <dt class="col-sm-3">Süre</dt>
    <dd class="col-sm-9">@Model.DurationMinutes dk</dd>
    <dt class="col-sm-3">Ücret</dt>
    <dd class="col-sm-9">@Model.Price.ToString("N2") ₺</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>