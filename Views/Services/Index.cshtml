@model IEnumerable<VeterinerKlinigi.Models.Service>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Hizmetler</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Hizmet</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Ad</th>
            <th>Klinik</th>
            <th>Süre (dk)</th>
            <th>Ücret (₺)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Clinic?.Name</td>
                <td>@s.DurationMinutes</td>
                <td>@s.Price.ToString("N2")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-warning">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz hizmet kaydı yok.</div>
}