@model VeterinerKlinigi.Models.Clinic
@{
    ViewData["Title"] = "Klinik Detayı";
}

<h2>@Model.Name</h2>
<hr />
<dl class="row">
    <dt class="col-sm-3">Adres</dt>
    <dd class="col-sm-9">@Model.Address</dd>
    <dt class="col-sm-3">Telefon</dt>
    <dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">E-posta</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Açıklama</dt>
    <dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Çalışma Saatleri</dt>
    <dd class="col-sm-9">@Model.OpeningTime.ToString("hh\\:mm") - @Model.ClosingTime.ToString("hh\\:mm")</dd>
</dl>

<h4>Hizmetler</h4>
<ul>
    @foreach (var s in Model.Services)
    {
        <li>@s.Name (@s.DurationMinutes dk - @s.Price.ToString("N2") ₺)</li>
    }
</ul>

<h4>Veterinerler</h4>
<ul>
    @foreach (var v in Model.Veterinarians)
    {
        <li>@v.FullName - @v.Specialties</li>
    }
</ul>

<a asp-action="Index" class="btn btn-secondary">Geri</a>