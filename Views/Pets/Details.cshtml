@model VeterinerKlinigi.Models.Pet
@{
    ViewData["Title"] = "Evcil Hayvan Detayı";
}

<h2>@Model.Name</h2>
<hr />
<dl class="row">
    <dt class="col-sm-3">Tür</dt>
    <dd class="col-sm-9">@Model.Species</dd>
    <dt class="col-sm-3">Irk</dt>
    <dd class="col-sm-9">@Model.Breed</dd>
    <dt class="col-sm-3">Doğum Tarihi</dt>
    <dd class="col-sm-9">@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("dd.MM.yyyy") : "-")</dd>
    <dt class="col-sm-3">Kilo</dt>
    <dd class="col-sm-9">@(Model.Weight.HasValue ? Model.Weight.Value.ToString("N2") + " kg" : "-")</dd>
    <dt class="col-sm-3">Sahip</dt>
    <dd class="col-sm-9">@Model.Owner?.FullName (@Model.Owner?.Email)</dd>
</dl>

<h4>Aşı Kayıtları</h4>
@if (Model.VaccineRecords.Any())
{
    <table class="table table-sm">
        <thead class="table-light">
            <tr>
                <th>Aşı</th>
                <th>Yapılma Tarihi</th>
                <th>Sonraki Doz</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model.VaccineRecords.OrderByDescending(v => v.AdministeredDate))
            {
                <tr>
                    <td>@v.VaccineName</td>
                    <td>@v.AdministeredDate.ToString("dd.MM.yyyy")</td>
                    <td>@(v.NextDueDate.HasValue ? v.NextDueDate.Value.ToString("dd.MM.yyyy") : "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Kayıtlı aşı yok.</p>
}

<h4>Randevular</h4>
@if (Model.Appointments.Any())
{
    <ul>
        @foreach (var a in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
        {
            <li>@a.AppointmentDate.ToString("dd.MM.yyyy HH:mm") - @a.Service?.Name (@a.Status)</li>
        }
    </ul>
}
else
{
    <p class="text-muted">Randevu yok.</p>
}

<a asp-action="Index" class="btn btn-secondary">Geri</a>