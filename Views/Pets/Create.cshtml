@model VeterinerKlinigi.Models.Pet
@{
    ViewData["Title"] = "Yeni Evcil Hayvan";
}

<h2>Yeni Evcil Hayvan</h2>
<hr />
<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Species" class="form-label"></label>
            <input asp-for="Species" class="form-control" placeholder="Kedi, Köpek, ..." />
            <span asp-validation-for="Species" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Breed" class="form-label"></label>
            <input asp-for="Breed" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="BirthDate" class="form-label"></label>
            <input asp-for="BirthDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Weight" class="form-label"></label>
            <input asp-for="Weight" class="form-control" />
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}