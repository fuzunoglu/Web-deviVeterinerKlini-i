@model VeterinerKlinigi.Models.VaccineRecord
@{
    ViewData["Title"] = "Aşı Kaydı Sil";
}

<h2>Aşı Kaydı Sil</h2>
<div class="alert alert-danger">Bu aşı kaydını silmek istediğinize emin misiniz?</div>
<dl class="row">
    <dt class="col-sm-3">Evcil Hayvan</dt>
    <dd class="col-sm-9">@Model.Pet?.Name</dd>
    <dt class="col-sm-3">Aşı</dt>
    <dd class="col-sm-9">@Model.VaccineName</dd>
    <dt class="col-sm-3">Yapılma Tarihi</dt>
    <dd class="col-sm-9">@Model.AdministeredDate.ToString("dd.MM.yyyy")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>